generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RecordStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
  DELETED
}

enum OrderStatus {
  DRAFT
  PENDING_PAYMENT
  CONFIRMED
  PACKING
  DISPATCHED
  DELIVERED
  COMPLETED
  CANCELLED
  RETURNED
  REFUNDED
  PARTIAL_RETURN
}

enum PaymentStatus {
  PENDING
  VERIFIED
  FAILED
  REFUNDED
  COD_PENDING
  COD_COLLECTED
}

enum DeliveryStatus {
  PACKING
  PICKUP_PENDING
  DISPATCHED
  IN_TRANSIT
  DELIVERED
  FAILED
  RETURNED
}

enum PurchaseStatus {
  DRAFT
  APPROVED
  PARTIALLY_RECEIVED
  RECEIVED
  CLOSED
  CANCELLED
}

enum MovementType {
  PURCHASE_RECEIVE
  SALE_RESERVE
  SALE_COMMIT
  SALE_RELEASE
  SALE_CANCEL
  RETURN_RESTOCK
  RETURN_DAMAGED
  STOCKTAKE_ADJUSTMENT
  MANUAL_CORRECTION
  TRANSFER_IN
  TRANSFER_OUT
}

model User {
  id              String     @id @default(uuid()) @db.Uuid
  roleId          String?    @db.Uuid
  fullName        String     @db.VarChar(160)
  email           String     @unique @db.VarChar(180)
  phone           String?    @db.VarChar(40)
  passwordHash    String
  emailVerifiedAt DateTime?  @db.Timestamptz(6)
  lastLoginAt     DateTime?  @db.Timestamptz(6)
  status          RecordStatus @default(ACTIVE)
  createdById     String?    @db.Uuid
  createdAt       DateTime   @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime   @updatedAt @db.Timestamptz(6)
  deletedAt       DateTime?  @db.Timestamptz(6)

  role            Role?      @relation(fields: [roleId], references: [id])
  sessions        Session[]
  auditLogs       AuditLog[]
  cashierShifts   CashierShift[] @relation("CashierUser")

  @@index([roleId])
  @@index([status])
}

model Role {
  id          String     @id @default(uuid()) @db.Uuid
  name        String     @unique @db.VarChar(80)
  description String?
  status      RecordStatus @default(ACTIVE)
  createdAt   DateTime   @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime   @updatedAt @db.Timestamptz(6)
  deletedAt   DateTime?  @db.Timestamptz(6)

  users       User[]
  permissions RolePermission[]
}

model Permission {
  id          String     @id @default(uuid()) @db.Uuid
  code        String     @unique @db.VarChar(120)
  module      String     @db.VarChar(80)
  action      String     @db.VarChar(80)
  description String?
  status      RecordStatus @default(ACTIVE)
  createdAt   DateTime   @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime   @updatedAt @db.Timestamptz(6)
  deletedAt   DateTime?  @db.Timestamptz(6)

  roles       RolePermission[]

  @@index([module, action])
}

model RolePermission {
  roleId       String   @db.Uuid
  permissionId String   @db.Uuid
  createdAt    DateTime @default(now()) @db.Timestamptz(6)

  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model Session {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @db.Uuid
  refreshTokenHash String
  ipAddress        String?   @db.VarChar(80)
  userAgent        String?
  expiresAt        DateTime  @db.Timestamptz(6)
  revokedAt        DateTime? @db.Timestamptz(6)
  status           RecordStatus @default(ACTIVE)
  createdAt        DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt        DateTime? @db.Timestamptz(6)

  user             User      @relation(fields: [userId], references: [id])

  @@index([userId, expiresAt])
}

model Customer {
  id            String    @id @default(uuid()) @db.Uuid
  fullName      String    @db.VarChar(160)
  phone         String    @unique @db.VarChar(40)
  email         String?   @db.VarChar(180)
  memberCode    String?   @unique @db.VarChar(60)
  loyaltyPoints Int       @default(0)
  status        RecordStatus @default(ACTIVE)
  createdAt     DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt     DateTime? @db.Timestamptz(6)

  addresses     Address[]
  orders        Order[]
  notifications Notification[]
}

model Address {
  id          String    @id @default(uuid()) @db.Uuid
  customerId  String?   @db.Uuid
  contactName String?   @db.VarChar(160)
  phone       String?   @db.VarChar(40)
  city        String    @db.VarChar(100)
  area        String?   @db.VarChar(140)
  street      String?
  landmark    String?
  isDefault   Boolean   @default(false)
  status      RecordStatus @default(ACTIVE)
  createdAt   DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt   DateTime? @db.Timestamptz(6)

  customer    Customer? @relation(fields: [customerId], references: [id])

  @@index([customerId])
}

model Category {
  id        String    @id @default(uuid()) @db.Uuid
  parentId  String?   @db.Uuid
  name      String    @db.VarChar(120)
  slug      String    @unique @db.VarChar(140)
  status    RecordStatus @default(ACTIVE)
  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt DateTime? @db.Timestamptz(6)

  parent    Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children  Category[] @relation("CategoryTree")
  products  Product[]
}

model Brand {
  id        String    @id @default(uuid()) @db.Uuid
  name      String    @unique @db.VarChar(120)
  status    RecordStatus @default(ACTIVE)
  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt DateTime? @db.Timestamptz(6)

  products  Product[]
}

model Supplier {
  id                 String    @id @default(uuid()) @db.Uuid
  name               String    @db.VarChar(180)
  contactName        String?   @db.VarChar(160)
  phone              String?   @db.VarChar(40)
  email              String?   @db.VarChar(180)
  address            String?
  outstandingBalance Decimal   @default(0) @db.Decimal(14, 2)
  status             RecordStatus @default(ACTIVE)
  createdAt          DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt          DateTime? @db.Timestamptz(6)

  products           Product[]
  purchaseOrders     PurchaseOrder[]
}

model Product {
  id              String    @id @default(uuid()) @db.Uuid
  categoryId      String?   @db.Uuid
  brandId         String?   @db.Uuid
  supplierId      String?   @db.Uuid
  name            String    @db.VarChar(180)
  slug            String    @unique @db.VarChar(220)
  description     String?
  material        String?   @db.VarChar(120)
  seoTitle        String?   @db.VarChar(180)
  seoDescription  String?
  showOnWebsite   Boolean   @default(true)
  isFeatured      Boolean   @default(false)
  isNewArrival    Boolean   @default(false)
  status          RecordStatus @default(ACTIVE)
  createdAt       DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt       DateTime? @db.Timestamptz(6)

  category        Category? @relation(fields: [categoryId], references: [id])
  brand           Brand?    @relation(fields: [brandId], references: [id])
  supplier        Supplier? @relation(fields: [supplierId], references: [id])
  variants        ProductVariant[]
  images          ProductImage[]

  @@index([categoryId])
  @@index([status, showOnWebsite])
}

model ProductVariant {
  id             String    @id @default(uuid()) @db.Uuid
  productId      String    @db.Uuid
  sku            String    @unique @db.VarChar(80)
  barcode        String?   @unique @db.VarChar(120)
  qrCode         String?
  size           String?   @db.VarChar(40)
  color          String?   @db.VarChar(80)
  fabric         String?   @db.VarChar(120)
  costPrice      Decimal   @default(0) @db.Decimal(14, 2)
  sellingPrice   Decimal   @default(0) @db.Decimal(14, 2)
  originalPrice  Decimal?  @db.Decimal(14, 2)
  reorderLevel   Int       @default(0)
  status         RecordStatus @default(ACTIVE)
  createdAt      DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt      DateTime? @db.Timestamptz(6)

  product        Product   @relation(fields: [productId], references: [id])
  images         ProductImage[]
  priceHistory   PriceHistory[]
  inventory      Inventory?
  movements      InventoryMovement[]
  orderItems     OrderItem[]
  purchaseItems  PurchaseItem[]
  returnItems    ReturnItem[]
  stocktakeItems StocktakeItem[]

  @@index([productId])
  @@index([sku])
  @@index([barcode])
}

model ProductImage {
  id         String    @id @default(uuid()) @db.Uuid
  productId  String    @db.Uuid
  variantId  String?   @db.Uuid
  storageKey String
  publicUrl  String
  altText    String?   @db.VarChar(220)
  sortOrder  Int       @default(0)
  isMain     Boolean   @default(false)
  status     RecordStatus @default(ACTIVE)
  createdAt  DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt  DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt  DateTime? @db.Timestamptz(6)

  product    Product   @relation(fields: [productId], references: [id])
  variant    ProductVariant? @relation(fields: [variantId], references: [id])
}

model PriceHistory {
  id        String    @id @default(uuid()) @db.Uuid
  variantId String    @db.Uuid
  oldPrice  Decimal?  @db.Decimal(14, 2)
  newPrice  Decimal   @db.Decimal(14, 2)
  reason    String?
  createdAt DateTime  @default(now()) @db.Timestamptz(6)

  variant   ProductVariant @relation(fields: [variantId], references: [id])
}

model Inventory {
  id        String    @id @default(uuid()) @db.Uuid
  variantId String    @unique @db.Uuid
  onHand    Int       @default(0)
  reserved  Int       @default(0)
  committed Int       @default(0)
  damaged   Int       @default(0)
  returned  Int       @default(0)
  inTransit Int       @default(0)
  version   Int       @default(1)
  status    RecordStatus @default(ACTIVE)
  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt DateTime? @db.Timestamptz(6)

  variant   ProductVariant @relation(fields: [variantId], references: [id])

  @@index([variantId, version])
}

model InventoryMovement {
  id             String       @id @default(uuid()) @db.Uuid
  variantId      String       @db.Uuid
  movementType   MovementType
  quantity       Int
  referenceType  String?      @db.VarChar(80)
  referenceId    String?      @db.Uuid
  previousOnHand Int
  newOnHand      Int
  reason         String?
  postedAt       DateTime     @default(now()) @db.Timestamptz(6)
  createdAt      DateTime     @default(now()) @db.Timestamptz(6)

  variant        ProductVariant @relation(fields: [variantId], references: [id])

  @@index([variantId, postedAt])
  @@index([referenceType, referenceId])
}

model PurchaseOrder {
  id             String    @id @default(uuid()) @db.Uuid
  supplierId     String    @db.Uuid
  purchaseNumber String    @unique @db.VarChar(80)
  invoiceNumber  String?   @db.VarChar(120)
  purchaseStatus PurchaseStatus @default(DRAFT)
  totalAmount    Decimal   @default(0) @db.Decimal(14, 2)
  paidAmount     Decimal   @default(0) @db.Decimal(14, 2)
  status         RecordStatus @default(ACTIVE)
  createdAt      DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt      DateTime? @db.Timestamptz(6)

  supplier       Supplier  @relation(fields: [supplierId], references: [id])
  items          PurchaseItem[]
}

model PurchaseItem {
  id              String    @id @default(uuid()) @db.Uuid
  purchaseOrderId String    @db.Uuid
  variantId       String    @db.Uuid
  orderedQty      Int
  receivedQty     Int       @default(0)
  unitCost        Decimal   @default(0) @db.Decimal(14, 2)
  status          RecordStatus @default(ACTIVE)
  createdAt       DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt       DateTime? @db.Timestamptz(6)

  purchaseOrder   PurchaseOrder  @relation(fields: [purchaseOrderId], references: [id])
  variant         ProductVariant @relation(fields: [variantId], references: [id])
}

model Order {
  id              String    @id @default(uuid()) @db.Uuid
  billNumber      String    @unique @db.VarChar(80)
  customerId      String?   @db.Uuid
  channel         String    @db.VarChar(40)
  fulfillmentMode String    @default("Delivery") @db.VarChar(60)
  subtotal        Decimal   @default(0) @db.Decimal(14, 2)
  discountAmount  Decimal   @default(0) @db.Decimal(14, 2)
  taxAmount       Decimal   @default(0) @db.Decimal(14, 2)
  deliveryCharge  Decimal   @default(0) @db.Decimal(14, 2)
  totalAmount     Decimal   @default(0) @db.Decimal(14, 2)
  paymentStatus   PaymentStatus @default(PENDING)
  orderStatus     OrderStatus @default(DRAFT)
  status          RecordStatus @default(ACTIVE)
  createdAt       DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt       DateTime? @db.Timestamptz(6)

  customer        Customer? @relation(fields: [customerId], references: [id])
  items           OrderItem[]
  payments        Payment[]
  delivery        Delivery?
  returns         Return[]

  @@index([customerId])
  @@index([billNumber])
  @@index([orderStatus, paymentStatus])
}

model OrderItem {
  id                    String   @id @default(uuid()) @db.Uuid
  orderId               String   @db.Uuid
  variantId             String   @db.Uuid
  productNameSnapshot   String   @db.VarChar(180)
  skuSnapshot           String   @db.VarChar(80)
  sizeSnapshot          String?  @db.VarChar(40)
  colorSnapshot         String?  @db.VarChar(80)
  quantity              Int
  unitPrice             Decimal  @db.Decimal(14, 2)
  discountAmount        Decimal  @default(0) @db.Decimal(14, 2)
  taxAmount             Decimal  @default(0) @db.Decimal(14, 2)
  lineTotal             Decimal  @db.Decimal(14, 2)
  status                RecordStatus @default(ACTIVE)
  createdAt             DateTime @default(now()) @db.Timestamptz(6)
  updatedAt             DateTime @updatedAt @db.Timestamptz(6)
  deletedAt             DateTime? @db.Timestamptz(6)

  order                 Order    @relation(fields: [orderId], references: [id])
  variant               ProductVariant @relation(fields: [variantId], references: [id])
  returnItems           ReturnItem[]

  @@index([orderId])
  @@index([variantId])
}

model Payment {
  id                 String    @id @default(uuid()) @db.Uuid
  orderId            String?   @db.Uuid
  paymentMethod      String    @db.VarChar(60)
  amount             Decimal   @db.Decimal(14, 2)
  gatewayReference   String?   @db.VarChar(180)
  verificationStatus PaymentStatus @default(PENDING)
  idempotencyKeyId   String?   @db.Uuid
  paidAt             DateTime? @db.Timestamptz(6)
  status             RecordStatus @default(ACTIVE)
  createdAt          DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt          DateTime? @db.Timestamptz(6)

  order              Order?    @relation(fields: [orderId], references: [id])
  refunds            Refund[]
  idempotencyKey     IdempotencyKey? @relation(fields: [idempotencyKeyId], references: [id])

  @@index([orderId])
  @@index([gatewayReference])
}

model Delivery {
  id             String    @id @default(uuid()) @db.Uuid
  orderId        String    @unique @db.Uuid
  billNumber     String    @db.VarChar(80)
  courier        String?   @db.VarChar(120)
  trackingNumber String?   @db.VarChar(120)
  productsToPack String
  contactName    String?   @db.VarChar(160)
  contactPhone   String?   @db.VarChar(40)
  city           String?   @db.VarChar(100)
  address        String?
  codAmount      Decimal   @default(0) @db.Decimal(14, 2)
  deliveryStatus DeliveryStatus @default(PACKING)
  status         RecordStatus @default(ACTIVE)
  createdAt      DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt      DateTime? @db.Timestamptz(6)

  order          Order     @relation(fields: [orderId], references: [id])

  @@index([billNumber])
  @@index([deliveryStatus])
}

model Return {
  id               String    @id @default(uuid()) @db.Uuid
  orderId          String?   @db.Uuid
  returnNumber     String    @unique @db.VarChar(80)
  reason           String    @db.VarChar(160)
  inspectionStatus String    @default("inspection_required") @db.VarChar(80)
  approvalStatus   String    @default("requested") @db.VarChar(60)
  notes            String?
  status           RecordStatus @default(ACTIVE)
  createdAt        DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt        DateTime? @db.Timestamptz(6)

  order            Order?    @relation(fields: [orderId], references: [id])
  items            ReturnItem[]
  refunds          Refund[]
}

model ReturnItem {
  id              String    @id @default(uuid()) @db.Uuid
  returnId        String    @db.Uuid
  orderItemId     String?   @db.Uuid
  variantId       String?   @db.Uuid
  quantity        Int
  restockDecision String    @default("pending") @db.VarChar(80)
  status          RecordStatus @default(ACTIVE)
  createdAt       DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt       DateTime? @db.Timestamptz(6)

  return          Return    @relation(fields: [returnId], references: [id])
  orderItem       OrderItem? @relation(fields: [orderItemId], references: [id])
  variant         ProductVariant? @relation(fields: [variantId], references: [id])
}

model Refund {
  id               String    @id @default(uuid()) @db.Uuid
  returnId         String?   @db.Uuid
  paymentId        String?   @db.Uuid
  refundMethod     String    @db.VarChar(60)
  amount           Decimal   @db.Decimal(14, 2)
  approvalStatus   String    @default("pending") @db.VarChar(60)
  gatewayReference String?   @db.VarChar(180)
  status           RecordStatus @default(ACTIVE)
  createdAt        DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt        DateTime? @db.Timestamptz(6)

  return           Return?   @relation(fields: [returnId], references: [id])
  payment          Payment?  @relation(fields: [paymentId], references: [id])
}

model Stocktake {
  id              String    @id @default(uuid()) @db.Uuid
  stocktakeNumber String    @unique @db.VarChar(80)
  countType       String    @db.VarChar(80)
  approvalStatus  String    @default("draft") @db.VarChar(60)
  notes           String?
  status          RecordStatus @default(ACTIVE)
  createdAt       DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt       DateTime? @db.Timestamptz(6)

  items           StocktakeItem[]
}

model StocktakeItem {
  id             String    @id @default(uuid()) @db.Uuid
  stocktakeId    String    @db.Uuid
  variantId      String    @db.Uuid
  systemQty      Int
  physicalQty    Int
  varianceQty    Int
  varianceValue  Decimal   @default(0) @db.Decimal(14, 2)
  reason         String?   @db.VarChar(160)
  status         RecordStatus @default(ACTIVE)
  createdAt      DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt      DateTime? @db.Timestamptz(6)

  stocktake      Stocktake @relation(fields: [stocktakeId], references: [id])
  variant        ProductVariant @relation(fields: [variantId], references: [id])
}

model CashierShift {
  id           String    @id @default(uuid()) @db.Uuid
  cashierId    String    @db.Uuid
  registerName String    @db.VarChar(120)
  openingCash  Decimal   @default(0) @db.Decimal(14, 2)
  cashSales    Decimal   @default(0) @db.Decimal(14, 2)
  cashRefunds  Decimal   @default(0) @db.Decimal(14, 2)
  expectedCash Decimal?  @db.Decimal(14, 2)
  actualCash   Decimal?  @db.Decimal(14, 2)
  difference   Decimal?  @db.Decimal(14, 2)
  openedAt     DateTime  @default(now()) @db.Timestamptz(6)
  closedAt     DateTime? @db.Timestamptz(6)
  status       String    @default("open") @db.VarChar(30)
  createdAt    DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt    DateTime? @db.Timestamptz(6)

  cashier      User      @relation("CashierUser", fields: [cashierId], references: [id])
}

model AuditLog {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String?   @db.Uuid
  action     String    @db.VarChar(120)
  entityType String?   @db.VarChar(120)
  entityId   String?   @db.Uuid
  oldValues  Json?
  newValues  Json?
  ipAddress  String?   @db.VarChar(80)
  userAgent  String?
  createdAt  DateTime  @default(now()) @db.Timestamptz(6)

  user       User?     @relation(fields: [userId], references: [id])

  @@index([entityType, entityId])
  @@index([userId, createdAt])
}

model Notification {
  id             String    @id @default(uuid()) @db.Uuid
  customerId     String?   @db.Uuid
  userId         String?   @db.Uuid
  channel        String    @db.VarChar(40)
  subject        String?   @db.VarChar(180)
  message        String
  deliveryStatus String    @default("queued") @db.VarChar(50)
  sentAt         DateTime? @db.Timestamptz(6)
  status         RecordStatus @default(ACTIVE)
  createdAt      DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt      DateTime? @db.Timestamptz(6)

  customer       Customer? @relation(fields: [customerId], references: [id])
}

model Setting {
  id        String    @id @default(uuid()) @db.Uuid
  key       String    @unique @db.VarChar(120)
  value     Json
  isSecret  Boolean   @default(false)
  status    RecordStatus @default(ACTIVE)
  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt DateTime? @db.Timestamptz(6)
}

model IdempotencyKey {
  id             String    @id @default(uuid()) @db.Uuid
  key            String    @unique @db.VarChar(160)
  scope          String    @db.VarChar(80)
  requestHash    String
  responseStatus Int?
  responseBody   Json?
  expiresAt      DateTime  @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @db.Timestamptz(6)

  payments       Payment[]

  @@index([scope, expiresAt])
}
